{
  "name": "electronova",
  "version": "1.0.0",
  "description": "Sistema ELECTRONOVA",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" --prefix-colors \"cyan,magenta\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "npm start --prefix backend",
    "seed": "npm run seed --prefix backend",
    "clear": "npm run clear --prefix backend",
    "install": "npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "electronova",
    "catalogo",
    "productos-electricos",
    "api"
  ],
  "author": "ELECTRONOVA",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
